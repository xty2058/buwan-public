# Copy to deploy/.env on the server and fill in. deploy/.env is ignored by Git — never commit it.

# Domain whose DNS A record points at this server (no https://, no path).
BUWAN_DOMAIN=buwan.example.com

# Required: reply model (DeepSeek) and memory/embedding (Alibaba Cloud DashScope).
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# Optional: character voice (MiniMax). Leave empty to disable voice.
MINIMAX_API_KEY=
TTS_MAX_CALLS=300
TTS_MAX_CHARS=20000

# Optional overrides.
# PROMPT_VERSION=linyu-v1.4
# REPLY_MODEL=deepseek-flash
# MEMORY_MODEL=qwen-flash

# Reply caps per Beijing day (chat replies, regenerations, reading-together replies; failures not counted).
DAILY_REPLY_LIMIT=60
DAILY_TOTAL_LIMIT=1500
