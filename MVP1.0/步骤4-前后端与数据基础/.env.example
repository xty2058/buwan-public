# Local development only. Paths are resolved relative to this folder.
APP_HOST=127.0.0.1
APP_PORT=8840
APP_ORIGIN=http://127.0.0.1:8840
APP_DB=runtime/app.sqlite3
APP_LOG_DIR=runtime/logs
APP_SESSION_HOURS=168
# Set true only behind HTTPS in a future deployment.
APP_COOKIE_SECURE=false

# Independent reply evaluation. No credentials are inherited from the chat model.
# BASE_URL: HTTPS Chat Completions prefix; MODEL: your exact provider model ID.
EVAL_DEEPSEEK_BASE_URL=
EVAL_DEEPSEEK_MODEL=
EVAL_DEEPSEEK_API_KEY=
EVAL_QWEN_BASE_URL=
EVAL_QWEN_MODEL=
EVAL_QWEN_API_KEY=
EVAL_DOUBAO_BASE_URL=
EVAL_DOUBAO_MODEL=
EVAL_DOUBAO_API_KEY=
EVAL_KIMI_BASE_URL=
EVAL_KIMI_MODEL=
EVAL_KIMI_API_KEY=
EVAL_GLM_BASE_URL=
EVAL_GLM_MODEL=
EVAL_GLM_API_KEY=
EVAL_MINIMAX_BASE_URL=
EVAL_MINIMAX_MODEL=
EVAL_MINIMAX_API_KEY=

# DEEPSEEK: currency units per million tokens; blank means unknown cost.
EVAL_DEEPSEEK_INPUT_PRICE_PER_MILLION=
EVAL_DEEPSEEK_CACHED_INPUT_PRICE_PER_MILLION=
EVAL_DEEPSEEK_OUTPUT_PRICE_PER_MILLION=
EVAL_DEEPSEEK_CURRENCY=CNY

# QWEN: currency units per million tokens; blank means unknown cost.
EVAL_QWEN_INPUT_PRICE_PER_MILLION=
EVAL_QWEN_CACHED_INPUT_PRICE_PER_MILLION=
EVAL_QWEN_OUTPUT_PRICE_PER_MILLION=
EVAL_QWEN_CURRENCY=CNY

# DOUBAO: currency units per million tokens; blank means unknown cost.
EVAL_DOUBAO_INPUT_PRICE_PER_MILLION=
EVAL_DOUBAO_CACHED_INPUT_PRICE_PER_MILLION=
EVAL_DOUBAO_OUTPUT_PRICE_PER_MILLION=
EVAL_DOUBAO_CURRENCY=CNY

# KIMI: currency units per million tokens; blank means unknown cost.
EVAL_KIMI_INPUT_PRICE_PER_MILLION=
EVAL_KIMI_CACHED_INPUT_PRICE_PER_MILLION=
EVAL_KIMI_OUTPUT_PRICE_PER_MILLION=
EVAL_KIMI_CURRENCY=CNY

# GLM: currency units per million tokens; blank means unknown cost.
EVAL_GLM_INPUT_PRICE_PER_MILLION=
EVAL_GLM_CACHED_INPUT_PRICE_PER_MILLION=
EVAL_GLM_OUTPUT_PRICE_PER_MILLION=
EVAL_GLM_CURRENCY=CNY

# MINIMAX: currency units per million tokens; blank means unknown cost.
